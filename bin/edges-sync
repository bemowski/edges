#!/bin/sh
# GitOps poller (edges-sync.timer runs it as root every 5 minutes).
# Fast-forwards this checkout to origin/main, then applies this host's config with wg-apply.
# git runs as the checkout's owner (bemo), so bemo's GitHub access is used.
set -eu
REPO=$(cd "$(dirname "$0")/.." && pwd)
OWNER=$(stat -c %U "$REPO")

g() {
    if [ "$(id -un)" = "$OWNER" ]; then
        git -C "$REPO" "$@"
    else
        runuser -u "$OWNER" -- git -C "$REPO" "$@"
    fi
}

g fetch -q origin main
HEAD=$(g rev-parse HEAD)
NEW=$(g rev-parse origin/main)
if [ "$HEAD" != "$NEW" ]; then
    if ! g merge -q --ff-only origin/main; then
        echo "edges-sync: can't fast-forward $HEAD to origin/main ($NEW); fix the checkout by hand" >&2
        exit 1
    fi
    echo "edges-sync: $HEAD -> $NEW"
fi
exec "$REPO/bin/wg-apply"
