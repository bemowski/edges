#!/usr/bin/env python3
"""Symmetrically encrypt files with gpg, writing <file>.asc next to each one."""
import argparse
from pathlib import Path

from pylib import crypt


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("files", nargs="+", type=Path)
    return parser.parse_args()


def encrypt_file(file, key):
    encrypted = Path(f"{file.resolve()}.asc")
    print(f"Encrypting {file} -> {encrypted}", flush=True)
    encrypted.write_bytes(crypt.encrypt(file.read_bytes(), key))


def main():
    args = parse_args()
    crypt.process(args.files, lambda file: encrypt_file(file, crypt.DEFAULT_KEY))


if __name__ == "__main__":
    main()
