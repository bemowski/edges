#!/usr/bin/env python3
"""Decrypt gpg-encrypted <file>.asc files, writing <file> next to each one.

Key choice: --key, else the key named in the file's header, else the default.
An existing <file> is only replaced if decryption succeeds.
"""
import argparse
import os
from pathlib import Path

from pylib import crypt


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--key", type=Path,
                        help=f"passphrase file (default: from file header, else {crypt.DEFAULT_KEY})")
    parser.add_argument("files", nargs="+", type=crypt.asc_file)
    return parser.parse_args()


def make_private(file):
    """Equivalent of chmod go-r."""
    os.chmod(file, file.stat().st_mode & ~0o044)


def decrypt_file(file, key):
    data = file.read_bytes()
    key = key or crypt.key_from_header(data) or crypt.DEFAULT_KEY
    decrypted = file.resolve().parent / file.stem
    print(f"Decrypting {file} -> {decrypted} (key: {key})", flush=True)
    decrypted.write_bytes(crypt.decrypt(data, key))
    make_private(decrypted)


def main():
    args = parse_args()
    key = args.key and args.key.expanduser()
    crypt.process(args.files, lambda file: decrypt_file(file, key))


if __name__ == "__main__":
    main()
