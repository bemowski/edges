# edges: generated by mono systems/net/wireguard/gen; do not edit
# Traffic on the wg interfaces may only flow between known site networks.
table inet edges_wg
delete table inet edges_wg
table inet edges_wg {
	set nets {
		type ipv4_addr
		flags interval
		elements = { 192.168.8.0/24, 192.168.20.0/24, 192.168.23.0/24, 192.168.30.0/24, 192.168.34.0/24, 192.168.40.0/24, 192.168.200.0/23 }
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname != { "wg0", "wg1" } accept
		ct state established,related accept
		ip saddr @nets accept
		drop
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname { "wg0", "wg1" } ip saddr @nets ip daddr @nets accept
		oifname { "wg0", "wg1" } ip saddr @nets ip daddr @nets accept
		iifname { "wg0", "wg1" } drop
		oifname { "wg0", "wg1" } drop
	}
}
